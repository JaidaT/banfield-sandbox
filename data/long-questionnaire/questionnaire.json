        },
        {
          "id": "style_sets",
          "kind": "pick_images",
          "prompt": "For each set, pick a favourite and a least favourite",
          "imageSets": [
            {
              "id": "living_rooms",
              "images": [
                { "id": "a", "label": "Living room A", "src": "/questionnaire/living-a.svg" },
                { "id": "b", "label": "Living room B", "src": "/questionnaire/living-b.svg" },
                { "id": "c", "label": "Living room C", "src": "/questionnaire/living-c.svg" },
                { "id": "d", "label": "Living room D", "src": "/questionnaire/living-d.svg" }
              ]
            },
            {
              "id": "kitchens",
              "images": [
